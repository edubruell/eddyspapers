.DS_Store
**/.DS_Store
*.Rproj

# Build output and dependencies (never commit)
node_modules/
**/node_modules/
frontends/*/dist/
frontends/*/.astro/
api/dist/
frontend_dist/

.Rproj.user
.Rhistory
.RData
.Ruserdata
local_ai/
localwip/
.positai

# Per-machine Claude Code settings
.claude/settings.local.json

# Generated rsync inventory of the RePEc tree — regenerated per run
repec_rsync_tree.txt

# Local scratch / WIP scripts
local_hacks.R
local_test.R
repec_wip.R

# Environment files anywhere in the tree — may hold API keys (e.g. the PUBLIC_ frontend
# keys that Astro inlines into the bundle). Repo-wide catch-all so no single .gitignore's
# exact-filename rule is the only thing standing between a key and a commit. Keep *.example
# templates tracked.
.env
.env.*
!.env*.example

# Contains a plaintext API key — never commit
SKILL.md

# local server-ops notes — setup + functionality (never publish)
ops_notes/

# Local outreach drafts (never publish)
local_mail/

# Cached analysis data — IP enrichment cache and search-log pulls (contain raw IPs)
stats/*.rds
