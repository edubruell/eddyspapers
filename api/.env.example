# Template for the API service's environment. Real values live in an untracked file:
#   dev  → api/.env          (loaded by `pnpm dev` via --env-file)
#   prod → /etc/agentic.env  (loaded by the systemd unit)
# Never put a real secret in this file — it is tracked.

# --- LLM + models (agentic pipeline) ---
OPENROUTER_API_KEY=
MODEL_WRITER=anthropic/claude-haiku-4-5
MODEL_WRITER_RETRY=anthropic/claude-haiku-4-5
MODEL_CLARIFIER=anthropic/claude-haiku-4-5
MODEL_ASSESSOR=anthropic/claude-haiku-4-5
MODEL_SYNTH=anthropic/claude-haiku-4-5
MAX_TOKENS_SYNTH=8000

# --- Auth ---
# Grandfathered all-scope password. Empty disables the key gate (dev only).
AGENTIC_PASSWORD=
# Server-only HMAC key behind agentic run IDs. MANDATORY whenever the gate is on:
# the service refuses to boot without it. Keep it STABLE — changing it re-keys every
# run ID (lit_search dedup resets; already-stored share links keep resolving).
#   openssl rand -base64 32
SEARCH_ID_SECRET=

# --- Data ---
DB_SNAPSHOT=
AGENTIC_DB_PATH=
AGENTIC_APPDATA_PATH=
CORS_ORIGINS=

# --- Mail: self-serve MCP key delivery (Strato mailbox) ---
# The signup route mails the minted key and never returns it in the HTTP response,
# so without these the route cannot issue keys.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=mcpkeys@eddyspapers.org
SMTP_PASS=
MAIL_FROM="Eddy's Papers <mcpkeys@eddyspapers.org>"

# --- Public URLs used in the key mail (defaults are the prod hosts) ---
MCP_PUBLIC_URL=https://agenticsearch.eduard-bruell.de/mcp
SITE_PUBLIC_URL=https://econpapers.eduard-bruell.de
